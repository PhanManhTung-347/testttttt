@model DashboardViewModel
@{
    ViewData["Title"] = "Thống kê Tổng quan";
}

<h2 class="mb-4 fw-bold text-dark"><i class="fa-solid fa-gauge-high me-2"></i>Dashboard Thống Kê</h2>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card card-counter bg-white shadow-sm border-start border-primary p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase mb-1">Tổng Số Đầu Sách</h6>
                    <h3 class="fw-bold mb-0 text-primary">@Model.TotalBooks</h3>
                </div>
                <i class="fa-solid fa-book-bookmark fa-2x text-primary opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-counter bg-white shadow-sm border-start border-success p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase mb-1">Sách Sẵn Sàng Mượn</h6>
                    <h3 class="fw-bold mb-0 text-success">@Model.AvailableBooks</h3>
                </div>
                <i class="fa-solid fa-circle-check fa-2x text-success opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-counter bg-white shadow-sm border-start border-warning p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase mb-1">Sách Đang Được Mượn</h6>
                    <h3 class="fw-bold mb-0 text-warning">@Model.BorrowedBooks</h3>
                </div>
                <i class="fa-solid fa-hand-holding-hand fa-2x text-warning opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-counter bg-white shadow-sm border-start border-info p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase mb-1">Phiếu Đang Mượn</h6>
                    <h3 class="fw-bold mb-0 text-info">@Model.ActiveTickets</h3>
                </div>
                <i class="fa-solid fa-clock fa-2x text-info opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-counter bg-white shadow-sm border-start border-secondary p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase mb-1">Phiếu Đã Trả</h6>
                    <h3 class="fw-bold mb-0 text-secondary">@Model.ReturnedTickets</h3>
                </div>
                <i class="fa-solid fa-folder-check fa-2x text-secondary opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-counter bg-white shadow-sm border-start border-danger p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase mb-1">Phiếu Quá Hạn</h6>
                    <h3 class="fw-bold mb-0 text-danger">@Model.OverdueTickets</h3>
                </div>
                <i class="fa-solid fa-triangle-exclamation fa-2x text-danger opacity-50"></i>
            </div>
        </div>
    </div>
</div>